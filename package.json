{
  "name": "saeed-ai",
  "version": "3.6.0",
  "description": "Saeed AI desktop agent",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "test": "node --check src/main.js && node --check src/realtime.js && node --check src/agent.js && node --check src/tools.js && node --check src/computer.js && node --check src/memory.js && node --check src/preload.js && node --check src/chat.js && node --check src/settings-new.js"
  },
  "dependencies": {
    "ws": "8.18.3",
    "three": "0.186.1",
    "imapflow": "2.0.7",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "electron": "38.8.6"
  },
  "build": {
    "appId": "ai.saeed.desktop",
    "productName": "Saeed AI",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Saeed.AI.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "buildVersion": "3.6.0",
    "icon": "assets/saeed.ico",
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "three/examples/jsm"
      },
      {
        "from": "node_modules/three/build",
        "to": "three/node_modules/three/build"
      },
      {
        "from": "node_modules/three/package.json",
        "to": "three/node_modules/three/package.json"
      }
    ]
  }
}
